@tailwind base;
@tailwind components;
@tailwind utilities;

/* =====================================================
   Custom Styles - Smart Travel Planner
   Color System:
   - Background: #F8FAFC (slate-50)
   - Surface/Cards: #FFFFFF (white)
   - Primary/Accent: #6366F1 (indigo-500)
   - Text Primary: #0F172A (slate-900)
   - Text Secondary: #64748B (slate-500)
   - Borders: #E2E8F0 (slate-200)
   - Success: #10B981 | Error: #EF4444 | Warning: #F59E0B | Info: #3B82F6
   ===================================================== */

/* Global Styles */
@layer base {
  body {
    @apply bg-[#F8FAFC] text-[#0F172A] antialiased;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: #E2E8F0;
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #94A3B8;
  }

  /* Inline code */
  code {
    @apply px-1.5 py-0.5 bg-slate-100 rounded text-sm font-mono;
  }

  /* Keyboard key */
  kbd {
    @apply px-2 py-1 bg-slate-100 border border-[#E2E8F0] rounded text-xs font-semibold shadow-sm;
  }
}

/* Component Styles */
@layer components {
  /* Message bubble */
  .message-bubble {
    @apply shadow-sm hover:shadow-md transition-shadow duration-200;
  }

  /* Sidebar item hover */
  .sidebar-item {
    @apply transition-all duration-200 hover:bg-slate-800/50 rounded-lg;
  }

  /* Input focus ring */
  .input-focus {
    @apply focus:ring-2 focus:ring-[#6366F1] focus:border-transparent outline-none;
  }

  /* Primary button */
  .btn-primary {
    @apply px-4 py-2 bg-[#6366F1] hover:bg-indigo-600 active:bg-indigo-700 text-white rounded-lg
           font-medium transition-all duration-200
           disabled:bg-slate-300 disabled:cursor-not-allowed
           hover:shadow-md;
  }

  /* Secondary button */
  .btn-secondary {
    @apply px-4 py-2 bg-slate-100 hover:bg-slate-200 active:bg-slate-300 text-[#0F172A] rounded-lg
           font-medium transition-all duration-200
           border border-[#E2E8F0] hover:border-slate-300;
  }

  /* Card */
  .card {
    @apply bg-white rounded-xl shadow-sm border border-[#E2E8F0] p-5
           hover:shadow-md transition-shadow duration-200;
  }
}

/* Utilities */
@layer utilities {
  /* Gradient backgrounds */
  .gradient-primary {
    background: linear-gradient(135deg, #6366F1 0%, #818CF8 100%);
  }

  .gradient-secondary {
    background: linear-gradient(135deg, #6366F1 0%, #A78BFA 100%);
  }

  /* Text gradient */
  .text-gradient {
    @apply bg-clip-text text-transparent bg-gradient-to-r from-indigo-500 to-violet-500;
  }

  /* Hide scrollbar but keep scrolling */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  /* Thin scrollbar */
  .scrollbar-thin {
    scrollbar-width: thin;
  }

  .scrollbar-thin::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  /* Glass effect */
  .glass {
    @apply bg-white/80 backdrop-blur-lg border border-white/20;
  }

  /* Hover lift effect */
  .hover-lift {
    @apply transition-all duration-200 hover:-translate-y-1 hover:shadow-md;
  }
}

/* Custom Animations */
@keyframes shimmer {
  0% {
    background-position: -1000px 0;
  }
  100% {
    background-position: 1000px 0;
  }
}

.animate-shimmer {
  animation: shimmer 2s infinite linear;
  background: linear-gradient(
    to right,
    #F8FAFC 0%,
    #E2E8F0 20%,
    #F8FAFC 40%,
    #F8FAFC 100%
  );
  background-size: 1000px 100%;
}

/* Typing animation */
@keyframes typing {
  from {
    width: 0;
  }
  to {
    width: 100%;
  }
}

@keyframes blink {
  50% {
    border-color: transparent;
  }
}

.typing-animation {
  overflow: hidden;
  border-right: 2px solid;
  white-space: nowrap;
  animation: typing 3.5s steps(40, end), blink 0.75s step-end infinite;
}

/* Responsive utilities */
@media (max-width: 768px) {
  .mobile-full {
    @apply w-full;
  }

  .mobile-hide {
    @apply hidden;
  }
}

/* Print styles */
@media print {
  .no-print {
    display: none !important;
  }

  body {
    @apply bg-white text-black;
  }
}
