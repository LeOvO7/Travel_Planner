# OpenWeather API Key
# Get your free API key at: https://openweathermap.org/api
# Note: You need to subscribe to "One Call API 3.0" (free tier available)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenAI API Key
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here


# RapidAPI Key (shared across Booking.com, Flights Sky, TripAdvisor)
# Subscriptions: booking-com15, flights-sky, tripadvisor16
RAPIDAPI_KEY=your_rapidapi_key_here

# Google Maps API Key (for frontend map display)
# Get your API key at: https://console.cloud.google.com/google/maps-apis
# Required APIs: Maps JavaScript API, Places API, Geocoding API, Directions API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here